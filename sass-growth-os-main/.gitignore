# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# TypeScript incremental build cache
*.tsbuildinfo

# Environment — never commit these
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/

# Claude Code
# launch.json is shared project config (the dev server everyone runs) and is
# committed. settings.local.json holds per-machine permissions and absolute
# paths, so it is not.
.claude/settings.local.json
.claude/worktrees/

# Vercel CLI link state — per-user, points at one account's project.
.vercel
